{
  "id": "vb-digital-life-companion-demo",
  "name": "数字生命伴侣",
  "description": "连接真实 Digital Life 状态、记忆、对话与语音服务的透明小屏伴侣。",
  "version": "1.1.0",
  "source": "digital-life-runtime",
  "files": ["index.html", "style.css", "app.js", "hardware_app.py", "manifest.json"],
  "capabilities": [
    "text-dialogue",
    "ranked-memory",
    "runtime-expression",
    "push-to-talk",
    "speech-synthesis",
    "offline-fallback"
  ],
  "controls": {
    "KEY1": "cycle-expression",
    "KEY2": "toggle-memory",
    "KEY3": "cycle-skin"
  },
  "screen": {
    "width": 480,
    "height": 360,
    "touch": false
  }
}
